[Unit]
Description=__NAME__ 24/7 Telegram yordamchi (jarvis-loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=__HOME__/brain
Environment=HOME=__HOME__
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/usr/bin/zsh __HOME__/jarvis/jarvis-loop.sh
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=25
StandardOutput=append:__HOME__/jarvis/watch.log
StandardError=append:__HOME__/jarvis/watch.log

[Install]
WantedBy=multi-user.target
